<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bienvenueblainville.sorting.SortingItemMapper">
    <sql id="columns">
        id, destination_type, bin_color, source_url
    </sql>

    <select id="findAll" resultType="com.bienvenueblainville.sorting.SortingItem">
        select <include refid="columns"/>
        from sorting_item
        order by id
    </select>

    <select id="findById" resultType="com.bienvenueblainville.sorting.SortingItem">
        select <include refid="columns"/>
        from sorting_item
        where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="map">
        insert into sorting_item (destination_type, bin_color, source_url)
        values (#{destinationType}, #{binColor}, #{sourceUrl})
    </insert>

    <update id="update">
        update sorting_item
        set destination_type = #{destinationType},
            bin_color = #{binColor},
            source_url = #{sourceUrl}
        where id = #{id}
    </update>

    <delete id="delete">
        delete from sorting_item where id = #{id}
    </delete>
</mapper>
