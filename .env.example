DB_NAME=bienvenue_blainville
DB_USERNAME=blainville_app
DB_PASSWORD=replace_with_a_local_dev_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
APP_JWT_SECRET=replace_with_a_long_random_development_secret
APP_ADMIN_EMAIL=admin@blainville.local
APP_ADMIN_PASSWORD=replace_with_a_local_dev_admin_password
MYSQL_PORT=3307
REDIS_PORT=6379
# Set to `none` to disable caching. Assistant quotas still require Redis.
CACHE_TYPE=redis
BACKEND_PORT=8080

# Sorting assistant. `template` answers straight from the retrieved guide
# entries - no key, no cost, works on a fresh clone. Set `anthropic` and supply
# your own key to have Claude do the wording instead; the retrieved entries
# stay the only facts either one may use. Never commit a real key.
ASSISTANT_PROVIDER=template
ASSISTANT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
ASSISTANT_RATE_LIMIT=30
KAFKA_PORT=9092
MONGO_PORT=27017
# The outbox always records into MySQL. This switch controls the relay and the
# consumers only, so turning it off keeps events on the table rather than
# losing them.
EVENTS_ENABLED=true
# `mysql` stores the audit trail in a JSON column of the database this app
# already runs; `mongodb` uses the document store. Same interface, same tests.
AUDIT_STORE=mysql
